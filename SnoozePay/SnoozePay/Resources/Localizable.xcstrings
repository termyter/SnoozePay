            "state" : "translated",
            "value" : "Откладывать не получится"
          }
        }
      }
    },
    "alarms.penalty" : {
      "comment" : "Alarm-card penalty line; %@ is the formatted price («50 ₽»). The minus is U+2212, per the design copy.",
