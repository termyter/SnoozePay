{
  "sourceLanguage" : "ru",
  "strings" : {
    "alarms.error.backend_unavailable" : {
      "comment" : "Alert body when AlarmKit authorization is missing, so nothing can be armed at all.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложению не разрешено ставить будильники, поэтому будильник не зазвонит. Разрешите будильники в Настройках."
          }
        }
      }
    },
    "alarms.error.load_failed" : {
      "comment" : "Alert body when the stored alarms JSON cannot be decoded (AlarmRepository.RepositoryError.decodeFailure).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить будильники. Свяжитесь с поддержкой."
          }
        }
      }
    },
    "alarms.error.save_blocked" : {
      "comment" : "Alert body when saving is refused because the stored alarms are corrupt (AlarmRepository.RepositoryError.persistBlocked).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранение заблокировано: данные повреждены. Восстановите состояние через настройки или свяжитесь с поддержкой."
          }
        }
      }
    },
    "alarms.error.save_failed" : {
      "comment" : "Alert body when encoding an alarm for storage fails (AlarmRepository.RepositoryError.encodeFailure).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить будильник. Попробуйте ещё раз."
          }
        }
      }
    },
    "alarms.error.schedule_failed" : {
      "comment" : "Alert body when AlarmKit rejects a schedule. %@ is the system's own message, which arrives already localized by the OS.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запланировать будильник: %@. Попробуйте ещё раз или удалите старые будильники."
          }
        }
      }
    },
    "common.snooze_affordability" : {
      "comment" : "Balance hint under the wallet balance and in the alarms-list sticky header: how many snoozes the remaining balance still buys. A plural VARIATION rather than the flat plural.* nouns, because this call site owns the whole phrase - see example.days_count in this file. common.* because it appears on two screens.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Хватит на ~%lld откладывания"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Хватит на ~%lld откладываний"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Хватит на ~%lld откладывание"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Хватит на ~%lld откладывания"
                }
              }
            }
          }
        }
      }
    },
    "create_alarm.wake_up" : {
      "comment" : "Header above the time wheel on the create-alarm sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подъём"
          }
        }
      }
    },
    "deposit.foreign_currency.dismiss" : {
      "comment" : "The single, acknowledging button on the foreign-currency alert. Nothing is offered to cancel, because nothing was started.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Понятно"
          }
        }
      }
    },
    "deposit.foreign_currency.message" : {
      "comment" : "Body of the foreign-currency refusal. %1$@ is the wallet's currency name, %2$@ the storefront's. One key rather than the six concatenated fragments it replaced: clause order is a property of the language, not of the layout.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Валюта кошелька — %1$@. App Store сейчас продаёт пакеты пополнения за другую валюту: %2$@. Пересчитать одно в другое приложение не может: курса у него нет, а выдумывать курс для ваших денег оно не станет. Пополнение в другой валюте недоступно. Остаток на балансе никуда не делся — его можно тратить как обычно."
          }
        }
      }
    },
    "deposit.foreign_currency.title" : {
      "comment" : "Title of the alert that refuses a top-up priced in a currency the wallet cannot hold.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другая валюта"
          }
        }
      }
    },
    "example.days_count" : {
      "comment" : "Worked example, not shipped copy. This is the shape a migrated call site should use once it owns the whole phrase: the number lives IN the string, so the catalogue picks the form for every language on its own. xcstringstool rejects a plural variation whose value does not reference the number, which is why the plural.* nouns below are separate top-level keys instead. Consume or delete this entry in #598-#601.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld дня"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld дней"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld день"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld дня"
                }
              }
            }
          }
        }
      }
    },
