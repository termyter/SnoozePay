          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день"
          }
        }
      }
    },
    "alarms.days.once" : {
      "comment" : "Alarm-card caps row: a one-shot alarm with no weekday set.",
      "extractionState" : "manual",
      "localizations" : {
