      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будни · Пн–Пт"
          }
        }
      }
    },
    "alarms.days.weekend" : {
      "comment" : "Alarm-card caps row: Sat+Sun.",
