    "deposit.balance_corrupted.message" : {
      "comment" : "Body shown when the user taps «Пополнить» on a corrupt balance: the top-up gate stays locked until acknowledgeCorruption() runs, so the generic retry copy would send the user in a loop (#419).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённый баланс некорректен. Пополнение недоступно, пока вы не сбросите баланс в ноль."
          }
        }
      }
    },
