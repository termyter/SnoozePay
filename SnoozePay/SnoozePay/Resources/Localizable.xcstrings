    "wallet.month.short_01" : {
      "comment" : "Abbreviated month name (январь) for the transaction-history period chips and the month grid of the picker sheet. Copy rather than calendar data, unlike the full names: ru_RU's own shortStandaloneMonthSymbols carry trailing periods, leave four months unabbreviated («март», «май», «июнь», «июль») and range from three to five characters, where the grid on artboard 21b is a fixed set of three-letter tokens.",
      "extractionState" : "manual",
      "localizations" : {
