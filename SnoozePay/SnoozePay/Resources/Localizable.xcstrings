{
  "sourceLanguage" : "ru",
  "strings" : {
    "alarms.backend_guard.action.open_settings" : {
      "comment" : "CTA on the AlarmKit requirement screen that deep-links into Settings, used by the states the app can no longer resolve on its own.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть Настройки"
          }
        }
      }
    },
    "alarms.backend_guard.action.request" : {
      "comment" : "CTA on the AlarmKit requirement screen that raises the system permission dialog in place.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить"
          }
        }
      }
    },
    "alarms.backend_guard.create_anyway" : {
      "comment" : "Alarms list: the escape hatch on the «alarms are not permitted» alert raised when the user taps «+».",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё равно создать"
          }
        }
      }
    },
    "alarms.backend_guard.enable_anyway" : {
      "comment" : "Alarms list: the escape hatch on the «alarms are not permitted» alert raised when the user switches an alarm on.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё равно включить"
          }
        }
      }
    },
    "alarms.backend_guard.message.indeterminate" : {
      "comment" : "AlarmKit requirement copy when the probe was inconclusive. Hedged on purpose: the app is reporting its own failure, not the user's.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение не смогло узнать, разрешены ли будильники и уведомления. Проверьте их в Настройках — без разрешения будильники не сработают."
          }
        }
      }
    },
    "alarms.backend_guard.message.not_requested" : {
      "comment" : "AlarmKit requirement copy when the grant has never been requested — the user can still be shown the system dialog in place. One entry although the source concatenated two Swift literals: it is one sentence pair and must stay reorderable in translation.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение ещё не спросило разрешение на будильники и уведомления. Без него созданные будильники не сработают."
          }
        }
      }
    },
    "alarms.backend_guard.message.unavailable" : {
      "comment" : "AlarmKit requirement copy when the grant was denied or revoked, so the only way back is Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешение на будильники и уведомления выключено. Включите его в Настройках — иначе созданные будильники не сработают."
          }
        }
      }
    },
    "alarms.backend_guard.title.indeterminate" : {
      "comment" : "Heading of the AlarmKit requirement screen when the authorization probe itself failed, so the app cannot say whether alarms will ring. Deliberately weaker than the «wont ring» heading — this state does not gate alarm creation.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить разрешения"
          }
        }
      }
    },
    "alarms.backend_guard.title.wont_ring" : {
      "comment" : "Heading of the AlarmKit permission requirement screen / banner, shown both when the grant was never asked for and when it is switched off. One entry for both states because the sentence is the same promise being broken; the message below it is what differs.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будильники не зазвонят"
          }
        }
      }
    },
    "alarms.balance_corrupted.later" : {
      "comment" : "Alarms list: dismisses the corrupt-balance alert without resetting the balance.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позже"
          }
        }
      }
    },
    "alarms.balance_corrupted.message" : {
      "comment" : "Alarms list: body of the corrupt-balance alert. %@ is the unreadable raw value, printed verbatim so a support request can quote it.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В хранилище обнаружено некорректное значение баланса (%@). Пополнения и списания приостановлены. Сбросить баланс до 0 ₽?"
          }
        }
      }
    },
    "alarms.balance_corrupted.reset" : {
      "comment" : "Alarms list: destructive action of the corrupt-balance alert — zeroes the stored balance.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбросить"
          }
        }
      }
    },
    "alarms.balance_corrupted.title" : {
      "comment" : "Alarms list: title of the alert shown when the stored balance cannot be read.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс повреждён"
          }
        }
      }
    },
    "alarms.button.delete" : {
      "comment" : "Destructive action for one alarm — the row's swipe action and the confirmation sheet's button.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить"
          }
        }
      }
    },
    "alarms.cell.accessibility" : {
      "comment" : "Alarm card, VoiceOver: opening of the composed summary. %@ is the alarm time («07:00»); the days, price and sound are appended as comma-separated fragments.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будильник %@"
          }
        }
      }
    },
    "alarms.cell.toggle_accessibility" : {
      "comment" : "Alarm card, VoiceOver label of the on/off switch. Unrelated to the stored default alarm name.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будильник"
          }
        }
      }
    },
    "alarms.days.every_day" : {
      "comment" : "Alarm-card caps row: the alarm repeats on all seven weekdays.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день"
          }
        }
      }
    },
    "alarms.days.once" : {
      "comment" : "Alarm-card caps row: a one-shot alarm with no weekday set.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Единожды"
          }
        }
      }
    },
    "alarms.days.once_on" : {
      "comment" : "Alarm-card caps row: a one-shot alarm limited to the listed weekdays (%@ is «Вт, Чт»). Kept as one string rather than assembled from parts so the separator and the word order stay translatable.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Единожды · %@"
          }
        }
      }
    },
    "alarms.days.weekdays" : {
      "comment" : "Alarm-card caps row: Mon-Fri. The weekday abbreviations are part of the copy here — another language may want a different range notation entirely.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будни · Пн–Пт"
          }
        }
      }
    },
    "alarms.days.weekdays_plain" : {
      "comment" : "Mon-Fri, without the day range. The bare form used where the row is too narrow for alarms.days.weekdays («Будни · Пн–Пт»).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будни"
          }
        }
      }
    },
    "alarms.days.weekend" : {
      "comment" : "Alarm-card caps row: Sat+Sun.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выходные"
          }
        }
      }
    },
    "alarms.days.weekend_range" : {
      "comment" : "Sat+Sun with the day range spelled out. The range is part of the copy: another language may want a different notation entirely.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выходные · Сб–Вс"
          }
        }
      }
    },
    "alarms.debug.reset_onboarding.message" : {
      "comment" : "DEBUG builds only: body of the alert confirming that onboarding state was cleared. Never ships to the App Store — no translation needed.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закройте приложение и запустите заново — увидите экран приветствия."
          }
        }
      }
    },
    "alarms.debug.reset_onboarding.title" : {
      "comment" : "DEBUG builds only: title of the alert confirming that onboarding state was cleared. Never ships to the App Store — no translation needed.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Онбординг сброшен"
          }
        }
      }
    },
    "alarms.default_name" : {
      "comment" : "The name a new alarm carries until the user types one of their own.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будильник"
          }
        }
      }
    },
    "alarms.delete.body" : {
      "comment" : "Delete sheet, the full subtitle: %1$@ is the alarm's context line («Будни · Пн–Пт · 07:00»), %2$@ the reassurance sentence. One key rather than a Swift concatenation so the sentence separator stays translatable.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@"
          }
        }
      }
    },
    "alarms.delete.once_at" : {
      "comment" : "Delete sheet, context line of a one-shot alarm with no weekday set. %@ is the time («07:00»).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Единожды · %@"
          }
        }
      }
    },
    "alarms.delete.once_on_at" : {
      "comment" : "Delete sheet, context line of a one-shot alarm limited to weekdays. %1$@ is the day range («Пн–Пт»), %2$@ the time («07:00»).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Единожды · %1$@ · %2$@"
          }
        }
      }
    },
    "alarms.delete.range_all" : {
      "comment" : "Delete sheet, day range covering the whole week. Used for one-shot alarms, where «Единожды» already occupies the leading slot.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пн–Вс"
          }
        }
      }
    },
    "alarms.delete.range_weekdays" : {
      "comment" : "Delete sheet, day range covering Mon-Fri. See alarms.delete.range_all.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пн–Пт"
          }
        }
      }
    },
    "alarms.delete.range_weekend" : {
      "comment" : "Delete sheet, day range covering Sat+Sun. See alarms.delete.range_all.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сб–Вс"
          }
        }
      }
    },
    "alarms.delete.reassurance" : {
      "comment" : "Delete sheet, the sentence that tells the user deleting an alarm does not touch their money. %@ is the formatted balance («840 ₽»).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс %@ останется на месте — он привязан к аккаунту, а не к будильнику."
          }
        }
      }
    },
    "alarms.delete.schedule_at" : {
      "comment" : "Delete sheet, context line of a repeating alarm. %1$@ is the day phrase («Будни · Пн–Пт»), %2$@ the time («07:00»).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "alarms.delete.title" : {
      "comment" : "Delete-confirmation sheet: headline above the reassurance that the balance stays put.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить будильник?"
          }
        }
      }
    },
    "alarms.empty.body" : {
      "comment" : "Body of the alarms-list empty state (SPAlarmsListEmptyState).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте первый — выставите время, цену откладывания и положите баланс."
          }
        }
      }
    },
    "alarms.empty.button" : {
      "comment" : "Money CTA of the alarms-list empty state (SPAlarmsListEmptyState).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создать будильник"
          }
        }
      }
    },
    "alarms.empty.title" : {
      "comment" : "Headline of the alarms-list empty state (SPAlarmsListEmptyState).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни одного будильника"
          }
        }
      }
    },
    "alarms.error.backend_unavailable" : {
      "comment" : "Alert body when AlarmKit authorization is missing, so nothing can be armed at all.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложению не разрешено ставить будильники, поэтому будильник не зазвонит. Разрешите будильники в Настройках."
          }
        }
      }
    },
    "alarms.error.data_title" : {
      "comment" : "Alarms list: title of the alert shown when the alarm store cannot be read.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошибка данных"
          }
        }
      }
    },
    "alarms.error.load_failed" : {
      "comment" : "Alert body when the stored alarms JSON cannot be decoded (AlarmRepository.RepositoryError.decodeFailure).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить будильники. Свяжитесь с поддержкой."
          }
        }
      }
    },
    "alarms.error.load_failed_fallback" : {
      "comment" : "Alarms list: body of the load-failure alert when the error carries no description of its own. The longer «alarms.error.load_failed» is the repository's own wording and adds the support-contact line.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить будильники."
          }
        }
      }
    },
    "alarms.error.rollback_persist_failed" : {
      "comment" : "Alert body when enabling an alarm failed AND undoing that failure also failed (#205); only a relaunch reconciles memory with disk.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось включить будильник и откатить изменение — данные могут быть в рассинхроне. Перезапустите приложение и проверьте список будильников."
          }
        }
      }
    },
    "alarms.error.save_blocked" : {
      "comment" : "Alert body when saving is refused because the stored alarms are corrupt (AlarmRepository.RepositoryError.persistBlocked).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранение заблокировано: данные повреждены. Восстановите состояние через настройки или свяжитесь с поддержкой."
          }
        }
      }
    },
    "alarms.error.save_failed" : {
      "comment" : "Alert body when encoding an alarm for storage fails (AlarmRepository.RepositoryError.encodeFailure).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить будильник. Попробуйте ещё раз."
          }
        }
      }
    },
    "alarms.error.schedule_failed" : {
      "comment" : "Alert body when AlarmKit rejects a schedule. %@ is the system's own message, which arrives already localized by the OS.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запланировать будильник: %@. Попробуйте ещё раз или удалите старые будильники."
          }
        }
      }
    },
    "alarms.hint.zero_balance" : {
      "comment" : "Caption under a 0 ₽ balance on the alarms list. Deliberately NOT «будильники не зазвонят» — the alarm still rings, the user just cannot pay to snooze it (#232).",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откладывать не получится"
          }
        }
      }
    },
    "alarms.penalty" : {
      "comment" : "Alarm-card penalty line; %@ is the formatted price («50 ₽»). The minus is U+2212, per the design copy.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "▲ ПОСПАТЬ ЕЩЁ: −%@"
          }
        }
      }
    },
    "alarms.streak.caps" : {
      "comment" : "Streak banner above the alarms list. %1$lld is the streak length, %2$@ the declined noun («день» / «дня» / «дней»). The call site upper-cases the whole line, which is why the noun arrives in lower case.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld %2$@ БЕЗ ОТКЛАДЫВАНИЙ"
          }
        }
      }
    },
    "alarms.streak.saved" : {
      "comment" : "Streak banner, second line: %@ is the money not spent on snoozes, already formatted with its currency.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сэкономили %@"
          }
        }
      }
    },
    "alarms.title" : {
      "comment" : "h1 of the alarms list, rendered by SPAlarmsListHeader.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будильники"
          }
        }
      }
    },
    "common.balance_corrupted.title" : {
      "comment" : "Alert title for a corrupt stored balance (#419). Three screens raise it — alarms list, wallet and the deposit sheet — with different bodies, so only the title is shared.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланс повреждён"
          }
        }
      }
    },
    "common.button.cancel" : {
      "comment" : "Cancelling action of an alert or action sheet; also dismisses a screen or sheet without applying the change.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмена"
          }
        }
      }
    },
    "common.button.close" : {
      "comment" : "Dismisses a modal that has nothing else to decide — the WokeMorning summary, the streak modal, the alarm-off warning.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть"
          }
        }
      }
    },
    "common.button.done" : {
      "comment" : "Confirms and leaves a screen whose changes are already applied.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готово"
          }
        }
      }
    },
    "common.button.later" : {
      "comment" : "Defers a prompt without acting on it — the balance-corruption alert keeps re-asking on the next appearance.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позже"
          }
        }
      }
    },
    "common.button.ok" : {
      "comment" : "Sole action of an informational UIAlertController. Acknowledges, never confirms — no alert using it destroys anything. Spelled «Ок», not «ОК» or «OK» — that is how it reads on screen today.",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ок"
          }
        }
      }
